# Copy to .env for local runs. Never commit the copy.

# Reached by container name on the edge network. Never public.
AUTH_JWKS_URL=http://bff:8000/api/.well-known/jwks.json
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_MIN_REFETCH_SECONDS=30

AUTH_ISSUER=acme-bff
AUTH_AUDIENCE=acme-web

# Shared with the BFF. Empty means no gateway token is injected, and the BFF
# then relies on network isolation alone.
AUTH_GATEWAY_TOKEN=
