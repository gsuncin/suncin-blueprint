# Copy to .env for local runs. Never commit the copy.

# mock | example. The mock provider needs no credentials, which is what lets
# local dev and CI run the full suite offline.
SVC_EXAMPLE_PROVIDER_MODE=mock

# Shared with the BFF, which mints a 60-second token per call. Empty is only
# valid in mock mode; any other mode with no secret fails closed with a 503.
SVC_EXAMPLE_JWT_SECRET=
SVC_EXAMPLE_JWT_ISSUER=acme-bff
SVC_EXAMPLE_JWT_AUDIENCE=acme-svc-example

SVC_EXAMPLE_EXAMPLE_BASE_URL=https://greetings.example.invalid
SVC_EXAMPLE_REQUEST_TIMEOUT_SECONDS=30
