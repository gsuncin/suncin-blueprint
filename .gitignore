# --- Secrets. Nothing here is ever committed. -------------------------------
# A file that was ever committed must be ROTATED, not just removed: everyone
# who cloned the repo still has it in their history.
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
secrets/

# Terraform. A .tfplan embeds the whole state, including user_data in
# plaintext — it is as sensitive as the state itself.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
.terraform/
.terraform.lock.hcl

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node -------------------------------------------------------------------
# A PATTERN WITHOUT A LEADING SLASH MATCHES AT ANY DEPTH. That is what you
# want for build output -- `dist/` must catch acme-web/dist, which is not at the
# repo root -- and it is a trap for anything that could also name a SOURCE
# directory. `lib/` is the one that bites: it silently swallows
# acme-web/src/lib, and the branch then ships imports referring to files git has
# never heard of. Anchor those (`/lib`), or do not add them.
node_modules/
dist/
.vite/
coverage/
playwright-report/
test-results/
.lighthouseci/
*.tsbuildinfo

# --- Agent scratch ----------------------------------------------------------
# Worktrees from `isolation: "worktree"` runs. ORCHESTRATION.md says to remove
# them after each wave; this makes a forgotten one harmless.
.claude/worktrees/
.claude/settings.local.json

# --- OS ---------------------------------------------------------------------
.DS_Store
*.log

# The changelog hook writes this next to the file and moves it into place.
# A failed run leaves it behind, where `git add -A` will pick it up.
.changelog.md.tmp

# scripts/worktree-bootstrap.sh writes this per worktree.
.worktree.env
