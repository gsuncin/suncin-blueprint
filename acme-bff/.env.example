# Copy to .env for local runs. Never commit the copy.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,bff,app.localhost
CSRF_TRUSTED_ORIGINS=http://app.localhost
CORS_ALLOWED_ORIGINS=http://app.localhost
DJANGO_ADMIN_PATH=admin
LOG_LEVEL=INFO
TIME_ZONE=UTC

DB_NAME=acme
DB_USER=acme
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# The RS256 signing key, PEM base64-encoded onto one line so it survives a
# .env file and a cloud-init env file. Generate with `make keys`.
# Required whenever DEBUG is off.
JWT_PRIVATE_KEY_B64=
JWT_ISSUER=acme-bff
JWT_AUDIENCE=acme-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1

AUTH_REFRESH_COOKIE_NAME=acme_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax

# Shared with the gateway. Empty means identity headers are not trusted at all,
# which is the safe default.
GATEWAY_TOKEN=

CELERY_BROKER_URL=amqp://acme:change-me@rabbitmq:5672//

# Container name on the internal network. There is no public URL for this,
# and there must not be one (C-12).
EXAMPLE_SERVICE_URL=http://svc-example:8000
EXAMPLE_SERVICE_JWT_SECRET=
EXAMPLE_SERVICE_JWT_AUDIENCE=acme-svc-example

# Fernet key, 32 url-safe base64 bytes. One per environment, never shared:
# a staging leak must not decrypt production.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
