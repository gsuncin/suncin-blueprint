# Root environment for docker compose. Copy to .env and fill in.
# `make keys` generates the two secrets that cannot be typed by hand.

# --- Django / BFF -----------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-something-long-and-random
ALLOWED_HOSTS=localhost,127.0.0.1,bff,app.localhost
CSRF_TRUSTED_ORIGINS=http://app.localhost
CORS_ALLOWED_ORIGINS=http://app.localhost
DJANGO_ADMIN_PATH=admin
LOG_LEVEL=INFO

DB_NAME=acme
DB_USER=acme
DB_PASSWORD=acme-dev
DB_HOST=postgres
DB_PORT=5432

RABBITMQ_PASSWORD=acme-dev

# --- Identity ---------------------------------------------------------------
# RS256 private key, PEM base64-encoded onto one line. `make keys` fills this.
# The gateway needs only the public half, which it fetches from the JWKS
# endpoint — it is never configured here.
JWT_PRIVATE_KEY_B64=
JWT_ISSUER=acme-bff
JWT_AUDIENCE=acme-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=1
AUTH_REFRESH_COOKIE_SECURE=False

# Shared between the gateway and the BFF, so a compromised container on the
# edge network cannot forge identity headers. `make keys` fills this.
GATEWAY_TOKEN=

# --- Services ---------------------------------------------------------------
SVC_EXAMPLE_PROVIDER_MODE=mock
# Shared with acme-svc-example. Empty is valid ONLY while the service runs its
# mock provider; any other mode with no secret fails closed with a 503.
EXAMPLE_SERVICE_JWT_SECRET=
EXAMPLE_SERVICE_URL=http://svc-example:8000

# Fernet key for provider credentials at rest. `make keys` fills this.
# One per environment, never shared: a staging leak must not decrypt production.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# --- Object storage ---------------------------------------------------------
# MinIO locally, any S3-compatible store in production. The BFF's composition
# root REFUSES TO START without the four marked required when DEBUG is off --
# that refusal is the feature, and it is why bff-tests.yml's `check --deploy`
# step has to set them too. A default here would turn "nobody configured
# storage" into "files silently went to the wrong bucket".
STORAGE_ENDPOINT=http://minio:9000
# Required. Also the MinIO root credentials in docker-compose.yml, so changing
# one changes the other -- `make keys` fills them.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required. Never anonymously readable: it holds tenant files.
STORAGE_BUCKET_PRIVATE=acme-private
# NOT required, and deliberately so -- nothing refuses to start without it.
STORAGE_BUCKET_PUBLIC=
STORAGE_REGION=us-east-1
# How long a presigned URL stays valid. Short: the URL is the capability, so
# anyone holding it is the bearer, and it travels through mail and chat.
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=26214400

# --- Observability ----------------------------------------------------------
# All optional. Every one of these no-ops when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
