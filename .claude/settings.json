{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(./scripts/run-all-tests.sh)",
      "Bash(./scripts/verify-isolation.sh)",
      "Bash(cd acme-bff && DEBUG=True DB_NAME=acme_scratch python manage.py test:*)",
      "Bash(cd acme-bff && DEBUG=True DB_NAME=acme_scratch python manage.py migrate:*)",
      "Bash(cd acme-bff && DEBUG=True DB_NAME=acme_scratch python manage.py makemigrations:*)",
      "Bash(cd acme-bff && DEBUG=True DB_NAME=acme_scratch python manage.py check:*)",
      "Bash(acme-svc-example/.venv/bin/pytest:*)",
      "Bash(acme-gateway/auth/.venv/bin/pytest:*)",
      "Bash(npm --prefix acme-web run lint)",
      "Bash(npm --prefix acme-web run build)",
      "Bash(npm --prefix acme-web run test:unit:*)",
      "Bash(npm --prefix acme-web run test:e2e:*)",
      "Bash(terraform -chdir=acme-tf/envs/oci validate)",
      "Bash(terraform -chdir=acme-tf/envs/existing-host validate)",
      "Bash(terraform fmt -check -recursive acme-tf)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker network inspect:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(./scripts/check-doc-links.sh:*)",
      "Bash(./scripts/verify-like-ci.sh:*)",
      "Bash(.github/scripts/check-deploy-contract.sh:*)",
      "Bash(make test-db:*)",
      "Bash(make test-db-reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "checking the hard rules",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-hard-rules.sh"
          },
          {
            "type": "command",
            "statusMessage": "checking the suite's working directory",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-bff-test-cwd.sh"
          },
          {
            "type": "command",
            "statusMessage": "checking the commit message",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-commit-attribution.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "checking relative links",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/warn-broken-md-links.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "checking for uncommitted work",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/warn-uncommitted-on-stop.sh"
          },
          {
            "type": "command",
            "statusMessage": "checking the work has a PR",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/require-pr-on-stop.sh"
          }
        ]
      }
    ]
  }
}
